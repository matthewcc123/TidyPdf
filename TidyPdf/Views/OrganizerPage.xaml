<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TidyPdf.Views.OrganizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TidyPdf.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:TidyPdf.ViewModels"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewmodels:OrganizerPageViewModel />
    </Page.DataContext>

    <Page.Resources>
        <converters:BoolToObjectConverter
            x:Key="BoolToOpacityConverter"
            FalseValue=".5"
            TrueValue="1" />
    </Page.Resources>

    <Grid Margin="0,4,0,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            Grid.Column="0"
            Margin="0,0,0,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Translation="0 0 8">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Padding="16"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Orientation="Vertical"
                Spacing="8">

                <Button
                    Height="42"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="Organize_Click"
                    IsEnabled="{Binding CanOrganize}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{Binding IsFileEmpty, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE74E;" />
                        <TextBlock VerticalAlignment="Center" Text="Organize" />
                    </StackPanel>
                </Button>
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="AddFile_Click"
                    IsEnabled="{Binding CanProcess}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                        <TextBlock VerticalAlignment="Center" Text="Add Files" />
                    </StackPanel>
                </Button>
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ClearFilesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="14" Glyph="&#xE894;" />
                        <TextBlock VerticalAlignment="Center" Text="Clear Files" />
                    </StackPanel>
                </Button>
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ResetPagesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock VerticalAlignment="Center" Text="Reset Pages" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListView
                x:Name="ListViewFiles"
                Grid.Row="1"
                Padding="12"
                AllowDrop="True"
                Background="{ThemeResource SystemAltLowColor}"
                CanReorderItems="True"
                IsHitTestVisible="{Binding CanEdit}"
                IsItemClickEnabled="True"
                ItemsSource="{Binding Files}"
                ReorderMode="Enabled"
                SelectionMode="None">

                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4,2,4,2" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:FileViewModel">
                        <Grid
                            Margin="0,0,0,0"
                            Padding="2"
                            BorderThickness="1"
                            ColumnSpacing="8"
                            CornerRadius="4"
                            Opacity="{Binding DataContext.CanEdit, ElementName=ListViewFiles, Converter={StaticResource BoolToOpacityConverter}}">

                            <ToolTipService.ToolTip>
                                <TextBlock Text="{Binding FullName}" />
                            </ToolTipService.ToolTip>

                            <Grid.Background>
                                <SolidColorBrush Opacity=".25" Color="{Binding ColorBrush.Color}" />
                            </Grid.Background>

                            <Grid.BorderBrush>
                                <SolidColorBrush Opacity=".5" Color="{Binding ColorBrush.Color}" />
                            </Grid.BorderBrush>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Command="{Binding DataContext.DeleteFileCommand, ElementName=ListViewFiles}"
                                CommandParameter="{Binding}">
                                <FontIcon FontSize="12" Glyph="&#xE74D;" />
                            </Button>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding FullName}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>
        <Grid
            Grid.Column="1"
            Margin="0,0,8,8"
            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
            CornerRadius="8">

            <GridView
                x:Name="GridViewPages"
                Padding="16,16,8,16"
                AllowDrop="True"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CanReorderItems="True"
                CornerRadius="8"
                DragOver="DragOver"
                IsHitTestVisible="{Binding CanEdit}"
                IsItemClickEnabled="True"
                ItemsSource="{Binding Pages}"
                ReorderMode="Enabled"
                SelectionMode="None">

                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid CacheLength="0.0" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,8,8" />
                    </Style>
                </GridView.ItemContainerStyle>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:PageViewModel">

                        <Border
                            Width="152"
                            Height="224"
                            Padding="8"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderThickness="2"
                            CornerRadius="4">

                            <ToolTipService.ToolTip>
                                <Image Width="256" Source="{Binding PreviewImage}" />
                            </ToolTipService.ToolTip>

                            <Border.BorderBrush>
                                <SolidColorBrush Opacity="0.5" Color="{Binding File.ColorBrush.Color}" />
                            </Border.BorderBrush>

                            <Grid RowSpacing="4">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="32" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Padding="4"
                                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    IsHitTestVisible="False">

                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                </Border>


                                <Grid Grid.Row="1" ColumnSpacing="4">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Column="0"
                                        VerticalAlignment="Stretch"
                                        Command="{Binding DataContext.DeletePageCommand, ElementName=GridViewPages}"
                                        CommandParameter="{Binding}">

                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                    </Button>

                                    <Border
                                        Grid.Column="1"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="4"
                                        IsHitTestVisible="False">

                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.25" Color="{Binding File.ColorBrush.Color}" />
                                        </Border.Background>

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding PageNumber}" />
                                    </Border>

                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Stretch"
                                        Command="{Binding DataContext.RotatePageCommand, ElementName=GridViewPages}"
                                        CommandParameter="{Binding}">

                                        <FontIcon FontSize="12" Glyph="&#xE7AD;" />
                                    </Button>

                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>

            </GridView>

            <controls:FileDropper
                x:Name="FileDropZone"
                CornerRadius="8"
                DragLeave="DragLeave"
                Drop="FileDropper_Drop"
                FileFormats="{Binding AllowedFormats}"
                IsEnabled="{Binding CanProcess}"
                ShowDashedLine="{Binding IsFileEmpty}"
                ShowText="{Binding IsFileEmpty}"
                Tapped="FileDropper_Tapped"
                Visibility="{Binding ShowDropZone, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Border
                Width="300"
                MinHeight="140"
                Padding="24,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False"
                Translation="0,0,32"
                Visibility="{Binding ProgressText, Converter={StaticResource StringVisibilityConverter}}">

                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>

                <StackPanel
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="14">

                    <ProgressRing
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        IsIndeterminate="True" />

                    <TextBlock
                        MaxLines="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding ProgressText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                </StackPanel>
            </Border>

        </Grid>

    </Grid>
</Page>
