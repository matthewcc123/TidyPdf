<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TidyPdf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TidyPdf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TidyPdf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TidyPdf"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="16,0,16,0">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <ImageIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Source="/Assets/WindowIcon.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Title}" />
            </StackPanel>
        </Grid>
        <NavigationView
            x:Name="MainNavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="False"
            ItemInvoked="MainNavView_ItemInvoked"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="NavigationView_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Organize" ToolTipService.ToolTip="Organize">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF5ED;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="DonateButton"
                    SelectsOnInvoked="False"
                    Tag="Donate"
                    ToolTipService.ToolTip="Support Developer">
                    <NavigationViewItem.Icon>
                        <FontIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xEB51;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="MainFrame" />
        </NavigationView>
    </Grid>

</Window>
