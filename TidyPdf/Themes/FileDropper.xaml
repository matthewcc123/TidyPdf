<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TidyPdf.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:local="using:TidyPdf">

    <converters:StringVisibilityConverter x:Key="StringVisibilityConverter" />

    <Style TargetType="controls:FileDropper">
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:FileDropper">
                    <Grid
                        Name="DropZone"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Rectangle
                            Name="DashOutline"
                            RadiusX="{Binding Path=CornerRadius.TopLeft, ElementName=DropZone}"
                            RadiusY="{Binding Path=CornerRadius.TopRight, ElementName=DropZone}"
                            Stroke="{TemplateBinding BorderBrush}"
                            StrokeDashArray="8 4"
                            StrokeThickness="1"
                            Visibility="{Binding ShowDashedLine, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Rectangle
                            Name="DropOutline"
                            Opacity="0"
                            RadiusX="{Binding Path=CornerRadius.TopLeft, ElementName=DropZone}"
                            RadiusY="{Binding Path=CornerRadius.TopRight, ElementName=DropZone}"
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                            StrokeThickness="2" />

                        <Rectangle
                            Name="DropOverlay"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="0"
                            RadiusX="{Binding Path=CornerRadius.TopLeft, ElementName=DropZone}"
                            RadiusY="{Binding Path=CornerRadius.TopRight, ElementName=DropZone}" />

                        <StackPanel
                            Margin="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="12"
                            Visibility="{Binding ShowText, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon
                                Name="FileIcon"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Glyph="&#xE898;" />
                            <StackPanel Orientation="Vertical" Spacing="8">
                                <TextBlock
                                    Name="InstructionText"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="Click to select files or drag and drop."
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Name="FileTypeText"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{TemplateBinding FileFormats}"
                                    TextWrapping="NoWrap"
                                    Visibility="{Binding FileFormats, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource StringVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="DropZone"
                                            Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                            Duration="0:0:0.075" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="DropOutline"
                                            Storyboard.TargetProperty="Opacity"
                                            Duration="0:0:0.075" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="DropOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            Duration="0:0:0.075" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="DropZone"
                                            Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                            To="{ThemeResource SubtleFillColorTertiary}"
                                            Duration="0:0:0.1">
                                            <ColorAnimation.EasingFunction>
                                                <CircleEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="DropZone"
                                            Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                            To="{ThemeResource SubtleFillColorSecondary}"
                                            Duration="0:0:0.1">
                                            <ColorAnimation.EasingFunction>
                                                <CircleEase EasingMode="EaseOut" />
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="DragOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="DropOutline"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CircleEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="DropOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To=".1"
                                            Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CircleEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="DropZone"
                                            Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                            To="{ThemeResource SubtleFillColorDisabledBrush}"
                                            Duration="0:0:0.075" />
                                        <ColorAnimation
                                            Storyboard.TargetName="FileIcon"
                                            Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)"
                                            To="{ThemeResource TextFillColorDisabled}"
                                            Duration="0:0:0.075" />
                                        <ColorAnimation
                                            Storyboard.TargetName="InstructionText"
                                            Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)"
                                            To="{ThemeResource TextFillColorDisabled}"
                                            Duration="0:0:0.075" />
                                        <ColorAnimation
                                            Storyboard.TargetName="FileTypeText"
                                            Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)"
                                            To="{ThemeResource TextFillColorDisabled}"
                                            Duration="0:0:0.075" />
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
